<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- CABEÇALHO COM A LOGO -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/circle_background"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/uni" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNICID • BLOCO D"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Navegação Indoor"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Selecione o destino desejado"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SEÇÃO: TÉRREO -->
        <LinearLayout
            android:id="@+id/sectionTerreo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@color/primary_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="TÉRREO (1º ANDAR)"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <Button
                    android:id="@+id/btnLab01"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mylocation"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Laboratório 01"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnLab02"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mylocation"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Laboratório 02"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnLab03"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mylocation"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Laboratório 03"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />
            </LinearLayout>
        </LinearLayout>

        <!-- SEÇÃO: SEGUNDO ANDAR -->
        <LinearLayout
            android:id="@+id/sectionAndar2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sectionTerreo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@color/primary_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="SEGUNDO ANDAR"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_background"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <Button
                    android:id="@+id/btnLab04"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Laboratório 04"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnLab05"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Laboratório 05"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnSala201"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Sala 201"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnSala202"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Sala 202"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnSala203"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Sala 203"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_color" />

                <Button
                    android:id="@+id/btnBiblioteca"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:drawableStart="@android:drawable/ic_menu_mapmode"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:text="Biblioteca"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:tint="@color/primary_blue" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>